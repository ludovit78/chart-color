{
  "manifest_version": 3,
  "name": "Chart Color",
  "version": "1.0.0",
  "description": "Send the open chord chart to Chart Color.",
  "action": {
    "default_title": "Send to Chart Color",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": [
    "https://tabs.ultimate-guitar.com/*",
    "https://www.ultimate-guitar.com/*",
    "https://ultimate-guitar.com/*",
    "https://www.e-chords.com/*",
    "https://www.cifraclub.com.br/*",
    "https://ludovit78.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
