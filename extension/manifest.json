{
  "manifest_version": 3,
  "name": "Chart Color",
  "version": "1.1.0",
  "description": "Send Ultimate Guitar and other chord pages into Chart Color.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "*://*.ultimate-guitar.com/*",
    "*://tabs.ultimate-guitar.com/*",
    "*://www.e-chords.com/*",
    "*://*.e-chords.com/*",
    "*://*.cifraclub.com.br/*",
    "https://ludovit78.github.io/*"
  ],
  "action": {
    "default_title": "Send this chart to Chart Color"
  },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "*://*.ultimate-guitar.com/*",
        "*://tabs.ultimate-guitar.com/*",
        "*://*.e-chords.com/*",
        "*://*.cifraclub.com.br/*"
      ],
      "js": ["extract.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ludovit78.github.io/chart-color/*"],
      "js": ["receiver.js"],
      "run_at": "document_idle"
    }
  ]
}
